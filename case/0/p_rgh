FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}

dimensions      [pressure];

internalField   uniform 0;

boundaryField
{
    frontAndBack
    {
        type            empty;
    }

    walls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    gasInlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    atmosphere
    {
        type            prghTotalPressure;
        p0              uniform 0;
        value           uniform 0;
    }
}
