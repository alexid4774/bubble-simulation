FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.water;
}

dimensions      [0 0 0 0 0 0 0];

internalField
{
    type            zonal;
    defaultValue    0;

    zones
    {
        initialWater
        {
            type        box;
            box         (0 0 -0.01) (0.1 0.1 0.01);
            value       1;
        }
    }
}

boundaryField
{
    frontAndBack
    {
        type            empty;
    }

    walls
    {
        type            zeroGradient;
    }

    gasInlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
}
